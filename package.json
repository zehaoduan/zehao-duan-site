{
  "name": "next-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate": "node scripts/generate-key-text.mjs && node scripts/generate-photo.mjs && node scripts/generate-blog.mjs",
    "generate:dev": "node scripts/generate-key-text.mjs && node scripts/generate-photo.mjs && node scripts/generate-blog.mjs --drafts",
    "predev": "npm run generate:dev",
    "dev": "node scripts/dev.mjs",
    "prebuild": "npm run generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cf:build": "npm run generate && opennextjs-cloudflare build",
    "preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:size": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy": "npm run cf:build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "gray-matter": "^4.0.3",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "unified": "^11.0.5",
    "wrangler": "^4.142.0"
  }
}
